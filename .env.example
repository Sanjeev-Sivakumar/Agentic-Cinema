# ==============================================================================
# Chain of Title — Local Development Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables for local development or testing.

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI & Intelligence Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_SCREENPLAY_MODEL=gemini-3.5-flash-lite
SCREENPLAY_PROVIDER=local
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
PARALLEL_API_KEY=your_parallel_api_key_here
RESEARCH_PROVIDER=parallel

# Multi-Agent Clearance Reasoning Mode ('offline' for deterministic testing, 'live' for real LLM/Search)
ADK_MODE=offline

# Phase 2 Video Pipeline Limits & Sampling Tuning
FRAME_SAMPLING_MODE=scene
FRAMES_PER_SCENE=1
MAX_FRAMES_PER_SCENE=2
VISION_FRAMES_PER_SCENE=1
GEMINI_FRAMES_PER_SCENE=1
MAX_VISION_FRAMES_PER_JOB=6
MAX_VIDEO_DURATION_SECONDS=300
YOLO_CONFIDENCE_THRESHOLD=0.45
OBJECT_CONFIDENCE_THRESHOLD=0.45

# Storage & Database Backends (Safe Local Defaults)
STORAGE_BACKEND=local
DATABASE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage

# Google Cloud Storage (Optional Cloud Backend — Default: Disabled)
GCP_PROJECT_ID=chain-of-title-cinema-2026
GCS_BUCKET=chain-of-title-cinema-2026
GCS_ENABLED=false

# Google Cloud Pub/Sub (Optional Event Sink — Default: Disabled)
PUBSUB_TOPIC=chain-of-title-events
PUBSUB_ENABLED=false
