# ==============================================================================
# Chain of Title — Google Cloud Run Production Environment Reference Template
# ==============================================================================
# This template defines all environment variables required for deploying the
# Chain of Title backend to Google Cloud Run with Google Cloud Storage and Pub/Sub.
#
# IMPORTANT SECURITY GUIDELINES:
# 1. NEVER commit production secrets or API keys to source control.
# 2. In Cloud Run, inject sensitive keys (GEMINI_API_KEY, PARALLEL_API_KEY) via
#    Google Secret Manager secrets or Cloud Run environment variables.
# 3. Use Cloud Run Workload Identity / Service Account IAM for Google Cloud Storage
#    and Pub/Sub access (no static service-account JSON key files required).
# ==============================================================================

# --- Application Core ---
APP_NAME=Chain of Title
APP_ENV=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8080
PORT=8080
CORS_ORIGINS=https://your-frontend-service.run.app,https://your-custom-domain.com

# --- Google Cloud Platform Infrastructure ---
GCP_PROJECT_ID=chain-of-title-cinema-2026
GOOGLE_CLOUD_PROJECT=chain-of-title-cinema-2026
GOOGLE_CLOUD_LOCATION=us-central1

# --- Google Cloud Storage (GCS) ---
# When deployed to Cloud Run, enable GCS for scalable, durable media & report storage
STORAGE_BACKEND=gcs
GCS_ENABLED=true
GCS_BUCKET=chain-of-title-cinema-2026

# --- Google Cloud Pub/Sub ---
# Enterprise event bus integration for real-time clearance status streaming
PUBSUB_ENABLED=true
PUBSUB_TOPIC=chain-of-title-events

# --- AI & Intelligence Engine ---
# Live multi-agent clearance reasoning mode
ADK_MODE=live
AI_PROVIDER=gemini
GEMINI_API_KEY=your_production_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_SCREENPLAY_MODEL=gemini-3.5-flash-lite
SCREENPLAY_PROVIDER=local

# Parallel Search API (USPTO and corporate trademark clearance intelligence)
RESEARCH_PROVIDER=parallel
PARALLEL_API_KEY=your_production_parallel_api_key_here

# Optional Fallback LLM (Groq)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# --- Video Processing & Sampling Budget ---
FRAME_SAMPLING_MODE=scene
FRAMES_PER_SCENE=1
MAX_FRAMES_PER_SCENE=2
VISION_FRAMES_PER_SCENE=1
GEMINI_FRAMES_PER_SCENE=1
MAX_VISION_FRAMES_PER_JOB=6
MAX_VIDEO_DURATION_SECONDS=300
YOLO_CONFIDENCE_THRESHOLD=0.45
OBJECT_CONFIDENCE_THRESHOLD=0.45
